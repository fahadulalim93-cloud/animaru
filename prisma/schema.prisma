generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bookmark {
  id        String   @id @default(cuid())
  animeId   String
  animeName String
  thumbnail String?
  score     Float?
  type      String?
  status    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([animeId])
}

model WatchHistory {
  id           String   @id @default(cuid())
  animeId      String
  animeName    String
  thumbnail    String?
  episodeNum   Float
  episodeTitle String?
  progress     Float    @default(0)
  duration     Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([animeId, episodeNum])
}

model Comment {
  id        String   @id @default(cuid())
  animeId   String
  episode   Float?
  username  String
  content   String
  parentId  String?
  rating    Int?
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userLikes CommentLike[]
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  username  String
  createdAt DateTime @default(now())

  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, username])
}

// ── Manga view tracking (our own view counter, layered on atsu.moe's base) ──
// Each manga has ONE row. Views increment every time a user opens the detail page.
// The displayed view count = atsu.moe's base views + our own views.
model MangaView {
  id        String   @id @default(cuid())
  mangaId   String   @unique          // e.g. "at:3xHoW" (prefixed like the rest of the app)
  views     Int      @default(0)      // our own view count (starts at 0)
  updatedAt DateTime @updatedAt

  ratings   MangaRating[]
}

// ── Manga ratings (our own user ratings, layered on atsu.moe's base) ──
// Each user can rate each manga once (upsert on [mangaId, username]).
// The displayed rating = weighted combination of atsu.moe's base rating
// and our users' ratings.
model MangaRating {
  id        String   @id @default(cuid())
  mangaId   String                     // e.g. "at:3xHoW"
  username  String                     // user identifier (from auth-local or session)
  rating    Float                       // 0.0 – 10.0
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manga     MangaView @relation(fields: [mangaId], references: [mangaId], onDelete: Cascade)

  @@unique([mangaId, username])
}

// ── Manga follows (user bookmarks/follows a manga to track reading) ──
// Follow = user is reading it. View = user just visited the detail page.
model MangaFollow {
  id        String   @id @default(cuid())
  mangaId   String
  username  String
  createdAt DateTime @default(now())

  @@unique([mangaId, username])
}

// ── Per-chapter comments (individual chapter, not whole manga) ──
// Users can comment while reading — comments are tied to a specific chapter.
model MangaChapterComment {
  id        String   @id @default(cuid())
  mangaId   String
  chapterId String                     // chapter identifier (atsu ID, mangaball translation ID, etc.)
  chapterNum Float                     // chapter number for display
  username  String
  text      String                     // comment text (max 1000 chars)
  likes     Int      @default(0)       // like count (denormalized for fast sorting)
  createdAt DateTime @default(now())

  likers    MangaChapterCommentLike[]

  @@index([mangaId, chapterId])
  @@index([mangaId, chapterId, likes(sort: Desc)])
  @@index([mangaId, chapterId, createdAt(sort: Desc)])
}

model MangaChapterCommentLike {
  id        String   @id @default(cuid())
  commentId String
  username  String
  createdAt DateTime @default(now())

  comment   MangaChapterComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, username])
}

// ── Vibe reviews (4-option quick review: drop/bold/great/recommended) ──
// Each user can give ONE vibe per manga. "VibeBar" shows the aggregate.
model MangaVibeReview {
  id        String   @id @default(cuid())
  mangaId   String
  username  String
  vibe      String   // "drop" | "bold" | "great" | "recommended"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mangaId, username])
}

// ══════════════════════════════════════════════════════════════════════════════
// KV (Key-Value) store — PostgreSQL-backed replacement for Upstash Redis/Vercel KV
// Powers the admin panel, moderation system, analytics, and announcements.
// These models emulate Redis data structures (strings, hashes, sorted sets, HLL)
// so all existing pipe() calls work transparently with PostgreSQL.
// ══════════════════════════════════════════════════════════════════════════════

// ── Simple key-value strings (emulates Redis GET/SET/INCR) ──
model KvStore {
  key   String @id
  value String
}

// ── Hash fields (emulates Redis HSET/HGET/HDEL/HGETALL/HINCRBY) ──
model KvHash {
  hash  String
  field String
  value String
  @@id([hash, field])
  @@index([hash])
}

// ── Sorted sets (emulates Redis ZADD/ZREMRANGEBYSCORE/ZCARD) ──
// Used for online-user tracking with score = timestamp.
model KvSortedSet {
  key    String
  member String
  score  Float
  @@id([key, member])
  @@index([key])
  @@index([key, score])
}

// ── HyperLogLog approximation (emulates Redis PFADD/PFCOUNT) ──
// Simplified: stores unique members in a set and counts them exactly.
// For the scale of this app (thousands of visitors), exact count is fine.
model KvHll {
  key    String
  member String
  @@id([key, member])
  @@index([key])
}

// ══════════════════════════════════════════════════════════════════════════════
// Admin Panel — PostgreSQL-native models
// ══════════════════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════════════════
// Regular user accounts — powers signup/login, comments, XP, progress, profile
// ══════════════════════════════════════════════════════════════════════════════

/// Regular site users (signup/login) — separate from AdminUser.
model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String?  @unique
  passwordHash  String
  name          String?

  // ── OAuth provider IDs (for "Continue with X" login) ──
  // When a user signs in via AniList OAuth, we find-or-create a User row
  // matching this anilistId. Null for users who signed up with a password.
  anilistId     Int?     @unique
  googleId      String?  @unique

  // Avatar / profile customization
  avatar        String?
  avatarColor   String?
  avatarEmoji   String?
  avatarImage   String?
  avatarFrame   String?
  banner        String?
  bannerImage   String?
  accentColor   String?
  tagline       String?
  bio           String?
  favorites     String   @default("[]") // JSON array of anime IDs

  // XP / progression
  xp            Int      @default(0)
  level         Int      @default(1)
  watchCount    Int      @default(0)
  episodeCount  Int      @default(0)
  commentCount  Int      @default(0)
  bookmarkCount Int      @default(0)

  active        Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      UserSession[]
  progress      UserProgress[]

  @@index([createdAt])
  @@index([xp(sort: Desc)])
  @@index([level])
}

/// Server-side user sessions (HTTP-only cookie tokens).
model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Per-user per-anime watch progress.
model UserProgress {
  id              String   @id @default(cuid())
  userId          String
  animeId         String
  animeName       String
  episodesWatched Int      @default(0)
  lastEpisodeNum  Float    @default(0)
  lastProgress    Float    @default(0) // 0–100 %
  xpEarned        Int      @default(0)
  watchTime       Int      @default(0) // seconds
  lastWatchedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([userId])
  @@index([lastWatchedAt(sort: Desc)])
}

// ══════════════════════════════════════════════════════════════════════════════
// Site visitor tracking — one row per (visitor fingerprint, day)
// Used for "Views Today / This Week / This Month" stat cards on admin Overview.
// ══════════════════════════════════════════════════════════════════════════════

model SiteVisitor {
  id         String   @id @default(cuid())
  visitorKey String                   // hashed IP+UA fingerprint
  date       String                   // "YYYY-MM-DD"
  userId     String?                  // null = anonymous
  page       String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@unique([visitorKey, date])
  @@index([date])
  @@index([userId])
}

/// Admin users with bcrypt-hashed passwords and role-based access.
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  role         String   @default("admin") // "owner" | "admin" | "mod"
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs    AuditLog[]
  sessions     AdminSession[]
}

/// Immutable audit trail for all admin/mod actions.
model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actorUsername  String
  action         String   // ban | unban | suspend | unsuspend | promote | demote | warn | edit_comment | delete_comment | create_announcement | delete_announcement | cache_purge | settings_change | login | logout
  targetType     String?  // "user" | "comment" | "announcement" | "cache" | "settings"
  targetId       String?
  details        String?  // JSON blob with action-specific context
  ip             String?
  createdAt      DateTime @default(now())

  actor          AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorUsername])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt(sort: Desc)])
}

/// Server-side sessions with HTTP-only cookie tokens.
model AdminSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Progressive AniList response cache.
/// Every successful AniList GraphQL response is saved here automatically.
/// Over time, this DB grows to cover every anime users have ever queried —
/// eliminating AniList API dependencies for popular content.
///
/// Cache key = stable hash of (query + variables) — same as in-memory LRU.
/// Response is the full AniList GraphQL `data` payload as JSON.
///
/// Lookup order in anilist-cache.ts:
///   1. In-memory LRU (instant)
///   2. PostgreSQL AniListCache (5-15ms — what this model powers)
///   3. AniList API (200-1000ms — also saved here for next time)
///   4. Embedded JSON DB (instant fallback for offline)
model AniListCache {
  id        String   @id @default(cuid())
  /// Stable cache key = hash of normalized query + sorted variables
  cacheKey  String   @unique
  /// The AniList ID this entry is about (extracted from variables.id when present).
  /// Null for non-Media queries (Page, trending, search, etc).
  anilistId Int?
  /// Operation type — derived from the query (Media, Page, Studio, etc).
  operation String?
  /// Full AniList GraphQL `data` payload as JSON string
  response  Json
  /// Where the data came from: 'anilist' | 'embedded-db-backfill'
  source    String   @default("anilist")
  /// Hit count — how many times this entry has been served from cache
  hits      Int      @default(0)
  /// Error count — if response was an error, count it (we still cache to avoid retry storms)
  errorCount Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([anilistId])
  @@index([operation])
  @@index([updatedAt(sort: Desc)])
  @@index([hits(sort: Desc)])
}

// ─── Watch Together (W2G) — synced watch parties with voice chat ──────────────
model WatchTogetherRoom {
  id            String    @id @default(cuid())
  code          String    @unique
  visibility    String
  animeId       Int
  episodeNum    Int
  animeTitle    String
  animeImage    String?
  hostUsername  String
  state         Json
  createdAt     DateTime  @default(now())
  lastActivity  DateTime  @default(now())
  closedAt      DateTime?
  members       WatchTogetherMember[]
  @@index([visibility, closedAt])
  @@index([hostUsername])
  @@index([lastActivity])
}
model WatchTogetherMember {
  id        String   @id @default(cuid())
  roomId    String
  username  String
  isHost    Boolean  @default(false)
  muted     Boolean  @default(false)
  joinedAt  DateTime @default(now())
  lastSeen  DateTime @default(now())
  room      WatchTogetherRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  @@unique([roomId, username])
  @@index([roomId])
}
