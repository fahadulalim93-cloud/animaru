{
  "name": "luffy-tv",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "frames": "node scripts/generate-frames.mjs",
    "predev": "node scripts/generate-frames.mjs || true",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/generate-frames.mjs || true",
    "build": "npx prisma generate || true && npx next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "postinstall": "npx prisma generate || true",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset"
  },
