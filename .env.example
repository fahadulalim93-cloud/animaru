# Database — PostgreSQL (Coolify / production)
# This single database powers: bookmarks, watch history, comments, manga data,
# AND the admin panel (user directory, moderation, announcements, analytics).
# No separate Redis/KV store needed — PostgreSQL handles it all.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# ── Optional: Upstash Redis / Vercel KV ──
# If deployed on Vercel with KV storage, set these for better analytics performance.
# Without these, the KV system automatically uses PostgreSQL (same DATABASE_URL).
# KV_REST_API_URL=https://your-upstash-redis.upstash.io
# KV_REST_API_TOKEN=your_upstash_token

# ── KLIPY GIF picker (comment composer "GIF" button) ──
# 1. Go to https://partner.klipy.com/api-keys and sign up
# 2. Grab the Test API Key (100 calls/hour, fine for testing) — request a
#    Production key later once you're ready (KLIPY advertises unlimited
#    free production requests).
# Server-only — no NEXT_PUBLIC_ prefix, the key never reaches the browser.
KLIPY_API_KEY=your_klipy_api_key_here

# TMDB API Key (v3) — get from https://www.themoviedb.org/settings/api
TMDB_API_KEY=dc7bf1ed4ae4ecbebaeb05f632a795c

# TMDB API Read Access Token (v4 Bearer)
TMDB_READ_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiJ9.eyJhdWQiOiJkYzdiZjFlZDRhZTRlY2JlYmFlYjA1ZjYzMmE3OTVjMSIsIm5iZiI6MTc3ODg4MjM1NC4xMzIsInN1YiI6IjZhMDc5NzMyMDNkNWQ4Njc2MjBmY2M2MyIsInNjb3BlcyI6WyJhcGlfcmVhZCJdLCJ2ZXJzaW9uIjoxfQ.-INB0VbPaZMHoNro-TRKyCwCIJ8f6AYvufaoqUgFdI0

# ── Cloudflare Workers ──
# Main proxy (video streams + m3u8 + segments) — handles ALL streams
# Deploy: worker/luffytv-proxy.js → Cloudflare Worker named "luffytv-proxy"
NEXT_PUBLIC_PROXY_BASE=https://luffytv-proxy.ggy892767.workers.dev

# Subtitle proxy (DEDICATED — .vtt/.srt/.ass only) — handles subtitle fetching
# + SRT→VTT conversion + ASS→VTT conversion + correct Referer per CDN
# Deploy: worker/luffytv-subs.js → Cloudflare Worker named "luffytv-subs"
# If not set, falls back to /api/stream (Vercel route, same conversion logic)
# DEPLOYED: https://luffytv-subtitle.ggy892767.workers.dev
NEXT_PUBLIC_SUBS_PROXY_BASE=https://luffytv-subtitle.ggy892767.workers.dev

# ── Google Sign-In (Continue with Google — real site login, not a list sync) ──
# 1. Go to https://console.cloud.google.com/apis/credentials → Create OAuth client ID
# 2. Application type: Web application
# 3. Add this site's origin under "Authorized JavaScript origins" (e.g. https://yourdomain.com)
# 4. No redirect URI or client secret needed (token popup flow) — paste the Client ID below
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# ── AniList account link (landing page "Connect AniList") ──
# 1. Go to https://anilist.co/settings/developer → Create New Client
# 2. Set Redirect URL to this site's homepage (e.g. https://yourdomain.com/)
# 3. Paste the Client ID below — no client secret is needed (implicit grant)
NEXT_PUBLIC_ANILIST_CLIENT_ID=your_anilist_client_id_here

# ── MyAnimeList account link ──
# 1. Go to https://myanimelist.net/apiconfig → Create ID → App Type: web
# 2. Set App Redirect URL to this site's homepage (e.g. https://yourdomain.com/)
# 3. Paste the Client ID and Client Secret below. Unlike AniList, MAL's OAuth
#    requires the secret — keep MAL_CLIENT_SECRET server-only (no NEXT_PUBLIC_).
NEXT_PUBLIC_MAL_CLIENT_ID=your_mal_client_id_here
MAL_CLIENT_SECRET=your_mal_client_secret_here

# ── Proxy Security ──
# XOR encryption key for proxy tokens (32 ASCII characters)
# IMPORTANT: Keep this secret and use the same value in your Cloudflare Worker
XOR_KEY=10b06cdc1ca48c9fb0b94af97cc040cf

# ── API Configuration ──
# Stream request timeout in milliseconds (default: 60000 = 60 seconds)
# Increase for slow connections or large files
STREAM_TIMEOUT_MS=60000
